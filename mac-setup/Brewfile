# Brewfile – schlanke Standard-Ausstattung (MacBook Air, wenig Speicher)
# Wird von weiter.sh benutzt. Alles unter "Bei Bedarf" installiert Claude erst,
# wenn ein Projekt es braucht:  brew install --cask <name>  bzw.  brew install <name>

# ---------- Kommandozeile / Basis (klein, von Claude ständig benutzt) ----------
brew "git"
brew "git-lfs"            # große Dateien (Game-Assets, 3D-Modelle)
brew "gh"                 # GitHub CLI
brew "jq"
brew "ripgrep"
brew "fd"
brew "wget"
brew "tree"
brew "mas"                # Mac-App-Store-CLI

# ---------- Sprachen & Build-Tools ----------
brew "node"               # für die meisten MCP-Server (npx) und Web-/App-Entwicklung
brew "pnpm"
brew "python@3.12"
brew "uv"                 # Python-Paketmanager, für Python-MCP-Server (uvx)
brew "cmake"
brew "ninja"
brew "cocoapods"          # iOS-Abhängigkeiten
brew "watchman"           # React Native

# ---------- Grafik-Werkzeuge für die Kommandozeile ----------
brew "imagemagick"
brew "ffmpeg"

# ---------- Programme ----------
cask "claude"             # Claude Desktop-App
cask "visual-studio-code" # Code-Editor
cask "google-chrome"      # Browser (Web-Apps testen, Playwright)
cask "blender"            # 3D-Modellierung, Animation, Game-Assets
cask "figma"              # UI-/Grafikdesign
cask "gimp"               # Bildbearbeitung
cask "freecad"            # CAD (Ersatz für Fusion 360)
cask "godot"              # leichte Game-Engine (~200 MB)
cask "epic-games"         # Launcher für Unreal Engine (Engine selbst bei Bedarf, am besten auf externer SSD)

# Xcode (ca. 15 GB) von Hand aus dem App Store laden.

