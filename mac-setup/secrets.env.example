# Kopieren nach ~/.claude/secrets.env und Werte eintragen.
#   cp mac-setup/secrets.env.example ~/.claude/secrets.env && chmod 600 ~/.claude/secrets.env
# Diese Datei NIE ins Git-Repo committen.

# GitHub: https://github.com/settings/personal-access-tokens (Fine-grained Token)
GITHUB_PAT=

# Ordner, auf die der Filesystem-MCP-Server zugreifen darf (Standard: ~/Projects)
# PROJECTS_DIR=$HOME/Projects
